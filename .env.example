# Variables de entorno requeridas — BIOSKIN Admin Panel
# Copia este archivo a .env.local y completa los valores antes de `vercel dev`.
# NUNCA subas .env.local ni .env al repositorio (están en .gitignore).
# Para producción: configura cada variable en el dashboard de Vercel.

# ─── Base de datos Neon PostgreSQL ───────────────────────────────────────────
# Pool owner (bypasea RLS, solo para migrations/admin)
NEON_DATABASE_URL=
# Pool Vercel Postgres (mismo Neon, con pooler)
POSTGRES_URL=
# Pool bioskin_app (rol restringido con RLS enforced — para queries clínicas)
# Construir: postgresql://bioskin_app:<pwd>@<neon-host>/neondb?sslmode=require
# Crear rol primero: BIOSKIN_APP_PASSWORD=<pwd> node scripts/setup-bioskin-role.mjs
NEON_APP_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=
# Clave adicional requerida para login del master_admin (openssl rand -hex 32)
MASTER_LOGIN_KEY=
# Secreto para inicializar el schema multi-tenant
ADMIN_SETUP_SECRET=
# Opcionales: sobreescriben master creds para el admin de clínica BIOSKIN
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Opcional: para el flujo de cambio de contraseña del master
MASTER_ADMIN_NEW_PASSWORD=
# Opcional: CORS origins adicionales (coma-separados). Sin esto usa defaults hardcodeados.
ADMIN_CORS_ORIGIN=

# ─── URL base de la app ──────────────────────────────────────────────────────
APP_URL=

# ─── Google OAuth (Calendar + Auth) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cuenta de servicio Google en Base64 (para Calendar en modo service account)
# Generar: [Convert]::ToBase64String([IO.File]::ReadAllBytes("credentials.json"))
GOOGLE_CREDENTIALS_BASE64=

# ─── Email (Gmail SMTP — service: 'gmail') ───────────────────────────────────
# Cuenta Gmail desde la que se envían correos de sistema (OTP, invitaciones, links)
# Usar App Password de Google si 2FA está activado: myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
# Opcional: destinatario de notificaciones admin (fallback si clínica no tiene staff_email)
EMAIL_TO=

# ─── IA — OpenAI ─────────────────────────────────────────────────────────────
# ⚠️  NO usar prefijo VITE_ — solo se consume en serverless functions (lib/ai-service.js)
OPENAI_API_KEY=

# ─── IA — Google Gemini ──────────────────────────────────────────────────────
# lib/finance-ai-service.js y lib/medical-finance-service.js buscan en este orden:
# GOOGLE_GEMINI_API_KEY → GEMINI_API_KEY → GOOGLE_API_KEY
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ─── Pagos — PayPhone ────────────────────────────────────────────────────────
PAYPHONE_APP_TOKEN=
PAYPHONE_CLIENT_ID=
PAYPHONE_ENCODING_PASSWORD=
PAYPHONE_SECRET_KEY=
PAYPHONE_STORE_ID=
PAYPHONE_IDENTIFICADOR=

# ─── Cloudflare R2 (fotos clínicas) ──────────────────────────────────────────
# Crear token en: Dashboard → R2 → Manage R2 API tokens → Create token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ─── WhatsApp (bot interno) ───────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GROUP_ID=

# ─── Otros ───────────────────────────────────────────────────────────────────
INTERNAL_BOT_SECRET=
CRON_SECRET=
